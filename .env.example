# Local Postgres from `docker compose up -d`. Deployed Workers use the Hyperdrive binding instead; set this to the Neon
# connection string only to run migrations, with sslmode=verify-full (Neon's string says require, which makes pg warn).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Production URL, no trailing slash. Inlined at build time for canonicals, the sitemap and share images.
# Required when NEXT_PUBLIC_SITE_ENV=production; defaults to http://localhost:3000 otherwise.
NEXT_PUBLIC_SITE_URL=
# Leave unset locally. Only `pnpm run deploy` sets it to "production"; any other build is noindex.
# NEXT_PUBLIC_SITE_ENV=
