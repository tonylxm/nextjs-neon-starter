# Local Postgres from `docker compose up -d`. In production, use the Neon pooled connection string, with sslmode=verify-full
# (Neon's copy-paste string says sslmode=require, which makes pg print a deprecation warning).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
