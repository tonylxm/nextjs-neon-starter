{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nextjs-neon-starter",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": { "enabled": true },
  // Create one per client database: wrangler hyperdrive create <name> --connection-string="<Neon direct URL>" --caching-disabled
  // localConnectionString is used by `pnpm preview` and points at the docker-compose database.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgres://postgres:postgres@localhost:5432/app",
    },
  ],
}
